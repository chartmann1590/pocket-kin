<?xml version="1.0" encoding="utf-8"?>
<!--
  The Wear OS companion's fallback channel reaches PhoneSyncServer (port 8765) at a
  dynamically discovered address: the phone's LAN IP advertised in each snapshot
  (e.g. http://192.168.x.x:8765), or loopback/10.0.2.2 on emulators. That address
  cannot be enumerated ahead of time, so on the watch cleartext stays enabled.

  This is safe because the watch app has no general browsing surface: its only
  endpoints are our own sync protocol and Google Play Services (HTTPS). Local-network
  cleartext to the paired phone never leaves the user's Wi-Fi. The phone app keeps a
  strict deny-by-default policy (it only ever talks HTTPS outward).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
