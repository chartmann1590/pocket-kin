<?xml version="1.0" encoding="utf-8"?>
<!--
  Explicit allowlist for Android 11 and lower auto backup. Gameplay state only:
  the Godot save (user://pocket-kin.json -> files/pocket-kin.json) plus the game
  prefs file. kin_private.xml (ad consent state) is implicitly excluded because
  specific includes act as an allowlist.
-->
<full-backup-content>
    <include domain="file" path="pocket-kin.json" />
    <include domain="file" path="pocket-kin.json.bak" />
    <include domain="sharedpref" path="kin_native.xml" />
</full-backup-content>
